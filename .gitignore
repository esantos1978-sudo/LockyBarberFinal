# ============================================
# Locky Barber - .gitignore optimizado
# ============================================

# --- Dependencias ---
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# --- Next.js ---
.next/
out/
build/
dist/

# --- Testing / Cobertura ---
coverage/
.nyc_output/

# --- Entorno y variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# NOTA: .env.example SÍ se incluye (documenta variables necesarias)
# NOTA: .env.production NO se excluye (puede contener config de build)

# --- Debug y logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
.cache/

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Vercel ---
.vercel

# --- Certificados ---
*.pem
*.p12
*.key

# --- Archivos temporales de diseño (si existen) ---
/design-assets/
/mockups/

# --- Archivos multimedia grandes (raw) ---
# Los videos comprimidos en public/ se incluyen
# Los raw sin comprimir se excluyen
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.raw
